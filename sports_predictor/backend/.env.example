APP_NAME=SportPredictor Pro
DEBUG=false
SECRET_KEY=your-secret-key-here

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/sportpredictor

# Cache (Redis)
REDIS_URL=redis://redis:6379

# API-Football (get key at https://rapidapi.com/api-sports/api/api-football)
API_FOOTBALL_KEY=your_api_football_key_here

# TheOddsAPI (get key at https://the-odds-api.com)
ODDS_API_KEY=your_odds_api_key_here

# Scheduler
DAILY_GENERATION_HOUR=7
DAILY_GENERATION_MINUTE=0
TICKETS_PER_DAY=5
TARGET_ODDS=5.0

# ML
MIN_CONFIDENCE=60
