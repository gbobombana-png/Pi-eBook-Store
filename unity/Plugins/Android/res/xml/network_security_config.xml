<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration de sécurité réseau Android.
  - HTTPS obligatoire en production.
  - Localhost autorisé en développement (backend local).
-->
<network-security-config>

    <!-- Autorisation locale pour le backend de dev -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>

    <!-- Pi Network — HTTPS uniquement -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">minepi.com</domain>
        <domain includeSubdomains="true">api.minepi.com</domain>
        <domain includeSubdomains="true">sdk.minepi.com</domain>
    </domain-config>

    <!-- Politique par défaut : HTTPS obligatoire -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
